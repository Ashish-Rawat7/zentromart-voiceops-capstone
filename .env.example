# The dataset is included in this project ZIP. This path is relative to this project folder.
DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026

# SQLite stores only local session state. No PostgreSQL is required.
SESSION_DB_PATH=./instance/sessions.sqlite3

# Gemini is optional. Rule-based answers still work without a key.
ENABLE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Exact local Streamlit origins
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_BASE_URL=http://127.0.0.1:8000

GNANI_API_KEY=
VOICE_STT_LANGUAGE=en-IN
VOICE_TTS_MODEL=timbre-v2.5
VOICE_TTS_NAME=Kaveri
VOICE_TTS_LANGUAGE=en-IN